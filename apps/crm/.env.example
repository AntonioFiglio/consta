# Somente no backend. Copie para .env.local nesta pasta.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Modelo do seu endpoint com suporte a PDF e saída estruturada na Responses API.
OPENAI_MODEL=
PORT=3007
# Sem senha, apenas demonstração sintética em loopback. Defina para ativar login.
APP_PASSWORD=
# Opcional: caminho absoluto do SQLite. Padrão: apps/crm/.data/consta.sqlite
# DATABASE_PATH=
# SEED_DEMO=false para iniciar um banco novo sem exemplos sintéticos.
SEED_DEMO=true
